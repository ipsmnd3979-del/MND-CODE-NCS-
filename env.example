# MND CODE — production backend environment (example only, no real secrets)
# Copy to .env on the server. Never commit .env or expose these values to the browser.

NODE_ENV=production
PORT=4000
APP_URL=https://mndcode.in
API_URL=https://mndcode.in/api
CORS_ORIGINS=https://mndcode.in,https://www.mndcode.in

# PostgreSQL
DATABASE_URL=postgresql://mndcode_app:CHANGE_ME@localhost:5432/mndcode
DATABASE_SSL=true

# Sessions / auth
SESSION_SECRET=generate-with-openssl-rand-base64-48
SESSION_TTL_HOURS=168
COOKIE_DOMAIN=mndcode.in
PASSWORD_HASH_MEMORY_KIB=65536
LOGIN_RATE_LIMIT_PER_15_MIN=10
CONTACT_RATE_LIMIT_PER_HOUR=5

# Object storage for course assets (S3-compatible)
STORAGE_BUCKET=mndcode-course-assets
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email (contact-form notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_NOTIFY_TO=

# Public site configuration (fill only with verified details)
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_ADDRESS=

# Analytics (leave empty unless configured with privacy controls)
ANALYTICS_ID=
